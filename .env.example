# ─── LLM Provider ────────────────────────────────────────────────────────────
# Set PROVIDER to one of: openai | groq | openrouter | gemini | ollama |
#   together | deepseek | nvidia | huggingface | cerebras
PROVIDER=openai

# Universal key (preferred — overrides provider-specific keys below)
API_KEY=

# Or set provider-specific keys:
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
CEREBRAS_API_KEY=

# ─── Scraper Model ────────────────────────────────────────────────────────────
# Model to use for ScraperAgent (defaults to gpt-4o-mini)
SCRAPER_MODEL=gpt-4o-mini

# ─── Optional MCP Servers + Search Tools ─────────────────────────────────────
# Each key enables an MCP server that adds extra tools to the agent.
# Without any keys, the agent still works using crawl4ai + DuckDuckGo.
#
# TAVILY_API_KEY    → Tavily MCP: `search` + `extract` (direct URL content pull)
#                     Free tier: 1,000/month — https://app.tavily.com/
# FIRECRAWL_API_KEY → Firecrawl MCP: `firecrawl_scrape`, `firecrawl_crawl`,
#                     `firecrawl_extract`, `firecrawl_deep_research`, `firecrawl_search`
#                     Free tier: 500 credits/month — https://www.firecrawl.dev/
# APIFY_API_KEY     → Apify MCP: 3,000+ pre-built scrapers (social media, SERP,
#                     e-commerce, YouTube, Amazon, LinkedIn...)
#                     Free tier: $5/month — https://console.apify.com/account/integrations
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_KEY=

# ─── Optional Output ─────────────────────────────────────────────────────────
# Default output directory for scraped JSON files (can be overridden per-run)
# OUTPUT_DIR=output
